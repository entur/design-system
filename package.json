{
  "name": "design-system",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "yarn build:packages && yarn build:documentation",
    "build:package": "lerna run build --scope \"@entur/$*\" | cat",
    "build:packages": "lerna run build --no-private",
    "build:documentation": "lerna run --scope @entur/documentation build",
    "build:documentation:skip-packages-dependency": "yarn workspace @entur/documentation build",
    "build:code-playground": "lerna run --scope @entur/code-playground build",
    "build:studio-linje": "lerna run --scope @entur/studio-linje build",
    "clean": "lerna clean",
    "clean:all": "yarn superClean && yarn install",
    "dev": "yarn start:documentation",
    "generate:props": "lerna run --scope @entur/documentation generate:props",
    "generate:playground-snippets": "tsx apps/code-playground/src/scripts/generate-snippets.ts",
    "lint": "oxlint packages/ apps/",
    "lint:fix": "oxlint --fix packages/ apps/",
    "lint:packages": "oxlint packages/",
    "lint:styles": "stylelint 'packages/**/*.{css,scss}' --ignore-path .gitignore",
    "lint:styles:package": "lerna run lint:styles --scope \"@entur/$*\"",
    "verify:skills": "node scripts/verify-skills/index.mjs",
    "prepublishOnly": "yarn build:packages && yarn lint && yarn test:single-run",
    "prerelease-packages": "HUSKY=0 lerna publish --conventional-commits --conventional-prerelease --pre-dist-tag next --preid beta",
    "prerelease-packages-after-failed-attempt": "HUSKY=0 lerna publish from-package --conventional-commits --conventional-prerelease --pre-dist-tag next --preid beta",
    "graduate-prerelease-packages": "HUSKY=0 lerna publish --conventional-commits  --conventional-graduate",
    "publish-packages": "HUSKY=0 lerna publish --conventional-commits",
    "publish-packages-after-failed-attempt": "HUSKY=0 lerna publish from-package --conventional-commits",
    "start": "yarn -s run start-warning",
    "start-warning": "node -e \"console.warn('\u001b[31mUNAVAILABLE: use \u001b[4m\u001b[32myarn start:documentation\u001b[0m\u001b[31m to start dev server for design system websit or \u001b[4m\u001b[32myarn start:package name\u001b[0m\u001b[31m to start watch mode for package called name\u001b[0m')\"",
    "start:code-playground": "lerna run --scope @entur/code-playground start",
    "start:code-playground-for-package": "lerna run start --scope \"@entur/$*\" | cat && yarn --cwd apps/code-playground start",
    "start:documentation": "lerna run --scope @entur/documentation start",
    "cleanStart:documentation": "lerna run --scope @entur/documentation clean-start",
    "start:package": "lerna run start --scope \"@entur/$*\" | cat",
    "superClean": "rm -rf node_modules apps/*/dist apps/*/node_modules packages/*/dist packages/*/node_modules packages/*/.rts2*",
    "test": "cross-env TZ=UTC lerna run test -- --passWithNoTests",
    "test:package": "cross-env TZ=UTC lerna run test --scope \"@entur/$*\" | cat",
    "test:single-run": "cross-env CI=true TZ=UTC yarn test",
    "test:watch": "cross-env TZ=UTC lerna run test --watch",
    "setup": "yarn && yarn build:packages",
    "deploy:documentation": "lerna exec --scope @entur/documentation -- yarn deploy-docs",
    "deploy:documentation:preview": "lerna exec --scope @entur/documentation -- yarn deploy-docs:preview",
    "gc:format": "cz"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": "24.14.0"
  },
  "browserslist": [
    "cover 90% in NO",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
