    "NumberedList": "../../../packages/typography/src/NumberedList.tsx",
    "UnorderedList": "../../../packages/typography/src/UnorderedList.tsx"
  },
  "dtsPropsFor": {
    "Contrast": "  /** Innholdet som vises på kontrastbakgrunn */\n  children?: React.ReactNode;\n  /** Ekstra klassenavn */\n  className?: string;\n  /** HTML-elementet eller React-komponenten som rendres (default \"div\") */\n  as?: React.ElementType;\n",
    "BreadcrumbItem": "  /** Teksten som vises */\n  children: React.ReactNode;\n  /** Lenkemål når elementet rendres som <a> (default) */\n  href?: string;\n  /** Komponenten som rendres (default \"a\") */\n  as?: React.ElementType;\n  /** Ekstra klassenavn */\n  className?: string;\n",
    "TopNavigationItem": "  /** Tekste som vises */\n  children: React.ReactNode;\n  /** Lenkemål når elementet rendres som <a> (default) */\n  href?: string;\n  /** Om komponenten vises som valgt eller ikke */\n  active?: boolean;\n  /** HTML-elementet eller React-komponenten som lager komponenten (default \"a\") */\n  as?: React.ElementType;\n  /** Ekstra klassenavn */\n  className?: string;\n",
    "SideNavigation": "  /** SideNavigation.Group, SideNavigation.Item og SideNavigation.ExpandableItem */\n  children: React.ReactNode;\n  /** Ekstra klassenavn */\n  className?: string;\n"
  },
