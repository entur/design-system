{
  "shape": "package",
  "pkg": "@entur/linje",
  "globalName": "EnturLinje",
  "entry": ".design-sync/.cache/linje/index.mjs",
  "buildCmd": "corepack yarn build:packages && node .design-sync/patch-dts.mjs && node .design-sync/illustrations.mjs import && node .design-sync/umbrella.mjs",
  "srcDir": "../../../packages",
  "cssEntry": "styles.css",
  "docsDir": "docs",
  "componentSrcMap": {
    "CalendarDate": null,
    "CalendarDateTime": null,
    "ZonedDateTime": null,
    "Time": null,
    "ConditionalWrapper": null,
    "InputGroupContextProvider": null,
    "SegmentedControlComponent": null,
    "Link": "../../../packages/typography/src/Link.tsx",
