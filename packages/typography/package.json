{
  "name": "@entur/typography",
  "version": "2.1.1",
  "license": "SEE LICENSE IN README.md",
  "main": "./dist/typography.cjs.js",
  "module": "./dist/typography.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/typography.esm.js",
      "require": "./dist/typography.cjs.js",
      "default": "./dist/typography.esm.js"
    },
    "./beta": {
      "types": "./dist/beta/types/index.d.ts",
      "import": "./dist/beta/esm/index.mjs",
      "require": "./dist/beta/cjs/index.cjs",
      "default": "./dist/beta/esm/index.mjs"
    },
    "./styles": "./dist/styles.css",
    "./beta/styles": "./dist/beta/styles/index.css",
    "./fonts/*": "./fonts/*",
    "./scripts/*": "./scripts/*",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./dist/beta": null,
    "./dist/beta/*": null
  },
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "files": [
    "dist",
    "scripts",
    "fonts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entur/design-system.git",
    "directory": "packages/typography"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:main && yarn build:beta && cp -r fonts dist/",
    "build:main": "vite build",
    "build:beta": "vite build --config vite.config.beta.ts",
    "test": "jest",
    "lint": "eslint src",
    "lint:styles": "stylelint 'src/beta**/*.{css,scss}'  --ignore-path ../../.gitignore",
    "start": "vite build --watch",
    "start:beta": "vite build --config vite.config.beta.ts --watch",
    "migrate": "./scripts/migrate-typography.mjs"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@entur/icons": "workspace:^",
    "@entur/tokens": "workspace:^",
    "@entur/utils": "workspace:^",
    "classnames": "^2.5.1",
    "modern-normalize": "^3.0.1"
  },
  "optionalDependencies": {
    "glob": "^11.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^10.4.9",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^7.32.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
