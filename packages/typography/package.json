{
  "name": "@entur/typography",
  "version": "1.9.12",
  "license": "SEE LICENSE IN README.md",
  "main": "dist/typography.cjs.js",
  "module": "dist/typography.esm.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/typography.esm.js",
      "require": "./dist/typography.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entur/design-system.git",
    "directory": "packages/typography"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && cp -r fonts dist/",
    "test": "jest",
    "lint": "eslint src",
    "start": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@entur/icons": "workspace:^",
    "@entur/tokens": "workspace:^",
    "@entur/utils": "workspace:^",
    "classnames": "^2.5.1",
    "normalize-scss": "^8.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^10.4.9",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^7.32.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
