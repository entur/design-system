{
  "name": "@entur/layout",
  "version": "4.0.0-next.1",
  "license": "EUPL-1.2",
  "main": "dist/layout.cjs.js",
  "module": "dist/layout.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/layout.esm.js",
      "require": "./dist/layout.cjs.js",
      "default": "./dist/layout.esm.js"
    },
    "./beta": {
      "types": "./dist/beta/types/index.d.ts",
      "import": "./dist/beta/esm/index.mjs",
      "require": "./dist/beta/cjs/index.cjs",
      "default": "./dist/beta/esm/index.mjs"
    },
    "./beta/styles": "./dist/beta/styles/index.css",
    "./styles": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css",
    "./dist/beta": null,
    "./dist/beta/*": null,
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entur/design-system.git",
    "directory": "packages/layout"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vite build --watch",
    "start:beta": "vite build --config vite.config.beta.ts --watch",
    "build": "yarn build:main && yarn build:beta",
    "build:main": "vite build",
    "build:beta": "vite build --config vite.config.beta.ts",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@entur/icons": "workspace:^",
    "@entur/tokens": "workspace:^",
    "@entur/typography": "workspace:^",
    "@entur/utils": "workspace:^",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "^5.0.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
