{
  "name": "@entur/styles",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "main": "dist/styles.cjs.js",
  "module": "dist/styles.esm.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/styles.esm.js",
      "require": "./dist/styles.cjs.js",
      "style": "./dist/index.css",
      "default": "./dist/styles.esm.js"
    },
    "./scss": "./dist/scss/index.scss",
    "./css": "./dist/css/index.css",
    "./scss/*": "./dist/scss/*",
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entur/design-system.git",
    "directory": "packages/styles"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build-styles.ts",
    "build:vite": "vite build",
    "start": "tsx scripts/build-styles.ts --watch",
    "test": "jest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@entur/alert": "workspace:^",
    "@entur/button": "workspace:^",
    "@entur/chip": "workspace:^",
    "@entur/datepicker": "workspace:^",
    "@entur/dropdown": "workspace:^",
    "@entur/expand": "workspace:^",
    "@entur/fileupload": "workspace:^",
    "@entur/form": "workspace:^",
    "@entur/grid": "workspace:^",
    "@entur/icons": "workspace:^",
    "@entur/layout": "workspace:^",
    "@entur/loader": "workspace:^",
    "@entur/menu": "workspace:^",
    "@entur/modal": "workspace:^",
    "@entur/tab": "workspace:^",
    "@entur/table": "workspace:^",
    "@entur/tokens": "workspace:^",
    "@entur/tooltip": "workspace:^",
    "@entur/travel": "workspace:^",
    "@entur/typography": "workspace:^",
    "@entur/utils": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^10.4.9",
    "@testing-library/user-event": "14.6.1",
    "eslint": "^7.32.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "sass": "^1.90.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
