    "clean": "gatsby clean && rm -rf dist/",
    "clean-start": "yarn clean && yarn start",
    "build:componentColors": "tsx src/utils/componentColors/buildVariables.ts",
    "generate-props": "tsx src/utils/componentProps/generate-props.ts",
